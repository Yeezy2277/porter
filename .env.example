# Everything is optional. With nothing set, Porter uses embedded Postgres (PGlite)
# and replays recorded model responses from samples/recordings.json.

# Postgres (Neon in production). Unset locally: .data/pglite is used.
DATABASE_URL=

# Live Claude calls. Set it with ../set-anthropic-key.sh (hidden input), never by pasting here in chat.
ANTHROPIC_API_KEY=
# Embeddings for stage 03 (Voyage AI; Anthropic recommends it and has no embedding model of its own).
# Unset: recorded vectors from samples/embeddings.json, or a local hashing stand-in.
VOYAGE_API_KEY=
# Model for live calls (default claude-opus-5-5).
PORTER_MODEL=
# On Vercel live calls stay off unless this is true, so a public demo never spends money by accident.
PORTER_LIVE=
# true: write every live response to samples/recordings.json so the demo and CI can replay it.
PORTER_RECORD=
